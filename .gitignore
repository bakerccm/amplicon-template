# ignore input and output data
# note trailing /* is required for use with !.gitkeep
/data/*.fastq.gz
/out/*

# ignore software
/software/*
!/software/readme.md

# ignore databases
/databases/*
!/databases/download.sh
!/databases/md5sums.txt
!/databases/readme.md

# ignore snakemake working files
/.snakemake
/snakemake.err
/snakemake.out

# ignore pbs files
/pbs/*
!/pbs/.gitkeep

# ignore Mac OS system files
.DS_Store

# retain .gitkeep files as placeholders in otherwise empty directories
!.gitkeep
